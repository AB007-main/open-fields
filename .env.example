# Copy to .env.local and fill in. Never commit the filled version.

# Supabase, from the project API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access. Only these emails can reach /admin.
ADMIN_EMAIL_ALLOWLIST=

# Anti spam on the public submit form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics, privacy friendly per WEBAPP_STANDARDS section 21
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
